    },
    "async": {
      "type": "array"
    },
    "cache": {
      "type": "object"
    },
    "security": {
      "type": "object"
    },
    "observability": {
      "type": "object"
    },
    "testing": {
      "type": "object"
    },
    "deployment": {
      "type": "object"
    }
  }
}
