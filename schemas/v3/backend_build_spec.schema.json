      "type": "object"
    },
    "data": {
      "type": "object"
    },
    "auth": {
      "type": [
        "object",
        "null"
      ]
    },
    "authorization": {
      "type": [
        "object",
        "null"
      ]
    },
    "api": {
      "type": "object"
    },
    "integrations": {
