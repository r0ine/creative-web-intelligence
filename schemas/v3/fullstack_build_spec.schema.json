{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Full-Stack Integration Specification",
  "type": "object",
  "required": [
    "frontend",
    "backendRequired",
    "integration",
    "quality"
  ],
  "properties": {
    "frontend": {
      "type": "object"
    },
    "backendRequired": {
      "type": "boolean"
    },
    "backend": {
      "type": [
        "object",
        "null"
      ]
    },
    "reference": {
      "type": [
        "object",
        "null"
      ]
    },
    "integration": {
      "type": "array"
    },
    "quality": {
      "type": "object"
    }
  }
}
