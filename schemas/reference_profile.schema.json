{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReferenceProfile",
  "type": "object",
  "required": [
    "id",
    "source",
    "confidence",
    "observed",
    "inferred",
    "capabilityMap"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "enum": [
        "VERIFIED",
        "INDEXED",
        "NEEDS_CAPTURE"
      ]
    },
    "observed": {
      "type": "object",
      "properties": {
        "composition": {
          "type": [
            "string",
            "array",
            "object",
            "null"
          ]
        },
        "grid": {
          "type": [
            "string",
            "array",
            "object",
            "null"
          ]
        },
        "typography": {
          "type": [
            "string",
            "array",
            "object",
            "null"
          ]
        },
        "color": {
          "type": [
            "string",
            "array",
            "object",
            "null"
          ]
        },
        "spacing": {
          "type": [
            "string",
            "array",
            "object",
            "null"
          ]
        },
        "motion": {
          "type": [
            "string",
            "array",
            "object",
            "null"
          ]
        },
        "camera": {
          "type": [
            "string",
            "array",
            "object",
            "null"
          ]
        },
        "threeD": {
          "type": [
            "string",
            "array",
            "object",
            "null"
          ]
        },
        "lighting": {
          "type": [
            "string",
            "array",
            "object",
            "null"
          ]
        },
        "materials": {
          "type": [
            "string",
            "array",
            "object",
            "null"
          ]
        },
        "shaders": {
          "type": [
            "string",
            "array",
            "object",
            "null"
          ]
        },
        "navigation": {
          "type": [
            "string",
            "array",
            "object",
            "null"
          ]
        },
        "interaction": {
          "type": [
            "string",
            "array",
            "object",
            "null"
          ]
        },
        "mobile": {
          "type": [
            "string",
            "array",
            "object",
            "null"
          ]
        }
      }
    },
    "inferred": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signatureDetails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "antiPatterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilityMap": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}